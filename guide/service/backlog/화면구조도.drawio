                <mxCell id="property_detail_screen" value="매물 상세 화면&#xa;━━━━━━━━━━━━━━━━&#xa;이미지 갤러리 (스와이프)&#xa;뒤로가기, 찜하기, 공유하기&#xa;━━━━━━━━━━━━━━━━&#xa;기본 정보&#xa;가격, 유형, 면적, 주소&#xa;━━━━━━━━━━━━━━━━&#xa;옵션/편의시설&#xa;상세 설명&#xa;주변 정보&#xa;━━━━━━━━━━━━━━━━&#xa;문의하기 버튼" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;" parent="1" vertex="1">
