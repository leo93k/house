                <mxCell id="agent_screen" value="담당 매물 화면&#xa;(부동산업자 전용)&#xa;━━━━━━━━━━━━━━━━&#xa;담당 매물&#xa;━━━━━━━━━━━━━━━━&#xa;매물 카드 리스트&#xa;상태: 거래중/예약중/완료&#xa;문의 수 표시" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;" parent="1" vertex="1">
