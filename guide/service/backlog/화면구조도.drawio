                <mxCell id="property_list_screen" value="매물 리스트 화면&#xa;━━━━━━━━━━━━━━━━&#xa;필터 바&#xa;━━━━━━━━━━━━━━━━&#xa;매물 리스트/그리드&#xa;(정렬, 필터)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="10" y="650" width="200" height="140" as="geometry"/>
