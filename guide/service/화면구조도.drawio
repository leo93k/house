                <mxCell id="notifications_screen" value="🔔 NOTIFICATIONS (/notifications)&#10;━━━━━━━━━━━━━━━━━━━━━━━━━&#10;Header:&#10;  [← Back] → Previous&#10;  &quot;Notifications&quot;&#10;━━━━━━━━━━━━━━━━━━━━━━━━━&#10;Notification List:&#10;  ┌───────────────────────────┐&#10;  │ 🔔 New message from...    │&#10;  │    &quot;Is the property...&quot;   │&#10;  │                  2 min ago│&#10;  ├───────────────────────────┤&#10;  │ ❤️ Price dropped by ₩50k  │&#10;  │                 1 hour ago│&#10;  ├───────────────────────────┤&#10;  │ 🏠 New property in area   │&#10;  │                   Yesterday│&#10;  └───────────────────────────┘&#10;━━━━━━━━━━━━━━━━━━━━━━━━━&#10;Actions:&#10;  [알림 터치] → Related Screen" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=11;fontColor=#000000;" parent="1" vertex="1">
